# Persistent data directory inside the backend container.
DATA_DIR=/data

# Comma-separated allowed browser origins; "*" allows all origins.
CORS_ORIGINS=*

# Maximum template upload size in megabytes.
MAX_UPLOAD_MB=10

# Host port for the frontend and reverse proxy.
APP_PORT=8080

# Frontend API path. Keep "/api" when using the included reverse proxy.
VITE_API_URL=/api
