# Persistent data directory inside the backend container.
DATA_DIR=/data

# Comma-separated allowed browser origins; "*" allows all origins.
CORS_ORIGINS=*

# Maximum template upload size in megabytes.
MAX_UPLOAD_MB=10

# Gmail SMTP sender configuration. Use a Google App Password, not your
# regular account password. Keep the password in the deployment environment.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Host port for the frontend and reverse proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Frontend API path. Keep "/api" when using the included reverse proxy.
VITE_API_URL=/api
